<UserControl x:Class="GameIndex.Views.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource GlassCardStyle}" Padding="16,12" MinHeight="96">
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="11" CharacterSpacing="120" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
    </Border>
</UserControl>
