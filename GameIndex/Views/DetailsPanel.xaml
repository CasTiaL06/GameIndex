<UserControl x:Class="GameIndex.Views.DetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameIndex.ViewModels"
             xmlns:local="using:GameIndex.Views">
    <Border Style="{StaticResource GlassCardStyle}" Margin="28,0,28,24" Padding="28,22" Background="{StaticResource OverlayPanelBrush}">
        <Grid RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Bind Vm.Selected.Title, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{x:Bind Vm.Selected.PlatformName, Mode=OneWay}" /><Run Text=" • " /><Run Text="{x:Bind Vm.Selected.StatusText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Click="Close_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE711;" FontSize="12" /><TextBlock Text="Close" /></StackPanel></Button>
            </Grid>

            <Pivot x:Name="Tabs" Grid.Row="1">
                <PivotItem Header="Overview">
                    <ScrollViewer>
                        <StackPanel Spacing="16" Padding="0,8,12,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <local:StatTile Grid.Column="0" Glyph="&#xE121;" Label="TOTAL PLAYTIME" Value="{x:Bind Vm.Selected.PlaytimeText, Mode=OneWay}" Detail="{x:Bind Vm.Selected.PlaytimeDetail, Mode=OneWay}" />
                                <local:StatTile Grid.Column="1" Glyph="&#xEDA2;" Label="GAME SIZE" Value="{x:Bind Vm.Selected.SizeText, Mode=OneWay}" Detail="{x:Bind Vm.Selected.SizeDetail, Mode=OneWay}" />
                                <local:StatTile Grid.Column="2" Glyph="&#xE787;" Label="LAST PLAYED" Value="{x:Bind Vm.Selected.LastPlayedText, Mode=OneWay}" Detail="{x:Bind Vm.Selected.LastPlayedDetail, Mode=OneWay}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <local:StatTile Grid.Column="0" Glyph="&#xE7B8;" Label="INSTALLED DLC" Value="{x:Bind Vm.Selected.DlcText, Mode=OneWay}" Detail="{x:Bind Vm.Selected.DlcDetail, Mode=OneWay}" />
                                <local:StatTile Grid.Column="1" Glyph="&#xE734;" Progress="{x:Bind Vm.Selected.AchievementProgress, Mode=OneWay}" Label="ACHIEVEMENTS" Value="{x:Bind Vm.Selected.AchievementsText, Mode=OneWay}" Detail="{x:Bind Vm.Selected.AchievementsDetail, Mode=OneWay}" />
                            </Grid>
                            <TextBlock Text="LOCATION" FontSize="11" CharacterSpacing="120" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Installation directory" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{x:Bind Vm.Selected.InstallDir, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Executable" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{x:Bind Vm.Selected.ExePath, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Launch method" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{x:Bind Vm.Selected.LaunchInfo, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Platform artwork &amp; logos: GameIndex shows the platform name and the game title as text. Official platform logos and game logo images are not bundled." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <PivotItem Header="Achievements">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind Vm.AchievementsNote, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Achievements}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:AchievementItem">
                                    <Grid ColumnSpacing="14" Padding="0,6" Opacity="{x:Bind ItemOpacity}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Image Source="{x:Bind Icon}" Width="48" Height="48" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Status}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Installed DLCs">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind Vm.DlcNote, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Dlcs}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DlcItem">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Status}" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Sessions">
                    <ListView ItemsSource="{x:Bind Vm.Sessions}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionItem">
                                <Grid Padding="0,6" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Start}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Duration}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Note}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>
            </Pivot>
        </Grid>
    </Border>
</UserControl>
