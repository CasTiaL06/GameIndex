<Application x:Class="GameIndex.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- GameIndex palette. Brush colors are mutated at runtime by ThemeService (theme, accent, transparency). -->
            <SolidColorBrush x:Key="WindowBgBrush" Color="#0B0D12" />
            <SolidColorBrush x:Key="SecondaryBgBrush" Color="#11151D" />
            <SolidColorBrush x:Key="GlassPanelBrush" Color="#B8191E2A" />
            <SolidColorBrush x:Key="OverlayPanelBrush" Color="#F2141822" />
            <SolidColorBrush x:Key="ElevatedPanelBrush" Color="#A6242B38" />
            <SolidColorBrush x:Key="BorderSoftBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="HoverBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#65D9FF" />
            <SolidColorBrush x:Key="Accent2Brush" Color="#8B7CFF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#929BAA" />
            <!-- Text that sits on top of game artwork always stays light -->
            <SolidColorBrush x:Key="OnArtTextBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="OnArtSecondaryBrush" Color="#C3CAD6" />

            <!-- Neon glass language: cyan -> electric blue -> violet edges (accent stop follows the user's accent colour) -->
            <LinearGradientBrush x:Key="NeonBorderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#9965D9FF" Offset="0" />
                <GradientStop Color="#664C8BFF" Offset="0.5" />
                <GradientStop Color="#998B7CFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PlayGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#65D9FF" Offset="0" />
                <GradientStop Color="#4C8BFF" Offset="0.55" />
                <GradientStop Color="#8B7CFF" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassPanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NeonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <!-- Primary PLAY button -->
            <Style x:Key="PlayButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#0B0D12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" CornerRadius="28" Background="{StaticResource PlayGradientBrush}" Padding="34,13">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Overlay.Opacity" Value="0.22" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Overlay.Opacity" Value="0.38" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Overlay" Background="White" Opacity="0" CornerRadius="28" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Secondary glass button -->
            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource OnArtTextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" CornerRadius="22" Background="{StaticResource ElevatedPanelBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Padding="16,10">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Overlay.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Overlay.Opacity" Value="1" /><Setter Target="Root.Opacity" Value="0.8" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Overlay" Background="{StaticResource HoverBrush}" Opacity="0" CornerRadius="22" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
