<UserControl x:Class="GameIndex.Views.GameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Slot: fixed layout cell. Never moves, so neighbouring cards can never be disturbed.
         Card: visual that is moved/scaled with a RenderTransform (does not participate in layout). -->
    <Grid x:Name="Slot" Width="136" Height="236" Background="Transparent">
        <Grid x:Name="Card" Width="120" Height="168" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="Xf" />
            </Grid.RenderTransform>
            <Border x:Name="CoverBorder" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderSoftBrush}" />
            <Border x:Name="CoverArt" CornerRadius="12" />
            <Image x:Name="IconImg" Width="72" Height="72" Stretch="Uniform" VerticalAlignment="Center" Margin="0,-26,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="Monogram" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-30,0,0"
                       Foreground="{StaticResource OnArtTextBrush}" Opacity="0.85" Visibility="Collapsed" />
            <TextBlock x:Name="FallbackTitle" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom" Margin="8,0,8,12"
                       MaxLines="3" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OnArtTextBrush}" />
            <Border x:Name="Ring" CornerRadius="12" BorderThickness="3" BorderBrush="{StaticResource AccentBrush}" Opacity="0" />
            <FontIcon x:Name="FavIcon" Glyph="&#xEB52;" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                      Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
            <Ellipse x:Name="RunDot" Width="10" Height="10" Fill="#4ADE80" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
