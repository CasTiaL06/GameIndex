<UserControl x:Class="GameIndex.Views.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource GlassCardStyle}" CornerRadius="20" Padding="16,14" MinHeight="108">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IconBox" Width="38" Height="38" CornerRadius="13" Background="{StaticResource HoverBrush}" VerticalAlignment="Top">
                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="17" Foreground="{StaticResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="11" CharacterSpacing="120" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
                <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Height="4" CornerRadius="2" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
