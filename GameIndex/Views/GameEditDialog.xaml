<ContentDialog x:Class="GameIndex.Views.GameEditDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               PrimaryButtonText="Save" CloseButtonText="Cancel" DefaultButton="Primary" IsPrimaryButtonEnabled="False" PrimaryButtonClick="Save_Click">
    <ScrollViewer MaxHeight="560">
        <StackPanel Spacing="10" Width="520">
            <TextBox x:Name="NameBox" Header="Game name" TextChanged="Field_Changed" />
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="ExeBox" Header="Executable path" TextChanged="Field_Changed" />
                <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="BrowseExe_Click" />
            </Grid>
            <TextBox x:Name="ArgsBox" Header="Launch arguments (optional)" />
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="WorkBox" Header="Working directory (optional)" />
                <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="BrowseWork_Click" />
            </Grid>
            <TextBox x:Name="PlatformBox" Header="Platform name (optional, e.g. itch.io)" />
            <ComboBox x:Name="CategoryBox" Header="Category (optional, type to create a new one)" IsEditable="True" HorizontalAlignment="Stretch" />
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="CoverBox" Header="Custom cover image (optional)" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="BrowseCover_Click" />
            </Grid>
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="BgBox" Header="Custom background image (optional)" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="BrowseBg_Click" />
            </Grid>
            <CheckBox x:Name="TrackFolderBox" Content="Track playtime for any process in the game's folder (for launcher EXEs that start the real game)" />
            <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
