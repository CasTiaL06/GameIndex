<Window x:Class="GameIndex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameIndex.ViewModels"
        xmlns:views="using:GameIndex.Views"
        Title="GameIndex">
    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" PreviewKeyDown="Root_PreviewKeyDown">

        <!-- ===== Dynamic background: fallback gradient, two cross-fading artwork layers, readability overlays ===== -->
        <Grid x:Name="BackgroundHost" IsHitTestVisible="False">
            <Rectangle x:Name="FallbackGradient">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0B0D12" Offset="0" />
                        <GradientStop Color="#1A1F33" Offset="0.6" />
                        <GradientStop Color="#242047" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Image x:Name="BgA" Stretch="UniformToFill" />
            <Image x:Name="BgB" Stretch="UniformToFill" Opacity="0" />
            <Rectangle x:Name="DimOverlay" Fill="Black" Opacity="0.35" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#CC0B0D12" Offset="0" />
                        <GradientStop Color="#00000000" Offset="0.7" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                        <GradientStop Color="#E60B0D12" Offset="0" />
                        <GradientStop Color="#00000000" Offset="0.62" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar ===== -->
            <Border x:Name="Sidebar" Grid.Column="0" Width="64" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="8,40,8,8">
                        <Button x:Name="MenuButton" Click="MenuButton_Click" Background="Transparent" BorderThickness="0" Width="48" Height="44" Padding="0" ToolTipService.ToolTip="Toggle sidebar">
                            <FontIcon Glyph="&#xE700;" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                    <ListView x:Name="NavList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.NavItems, Mode=OneWay}" SelectionMode="Single" SelectionChanged="NavList_SelectionChanged"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Padding="8,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                                <Setter Property="MinHeight" Value="40" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Grid ColumnSpacing="8" Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Visibility="{x:Bind ItemVisibility}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{x:Bind ItemVisibility}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.ColumnSpan="2" Text="{x:Bind Label}" FontSize="10" CharacterSpacing="150" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{x:Bind HeaderVisibility}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Margin="8,0,8,12" Spacing="4">
                        <Button x:Name="AddButton" Click="AddButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="44" Padding="14,0">
                            <StackPanel Orientation="Horizontal" Spacing="16"><FontIcon Glyph="&#xE710;" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Add Game" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" /></StackPanel>
                        </Button>
                        <Button x:Name="ScanButton" Click="ScanButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="44" Padding="14,0">
                            <StackPanel Orientation="Horizontal" Spacing="16"><FontIcon Glyph="&#xE72C;" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Scan for games" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" /></StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" Click="SettingsButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="44" Padding="14,0">
                            <StackPanel Orientation="Horizontal" Spacing="16"><FontIcon Glyph="&#xE713;" Foreground="{StaticResource TextPrimaryBrush}" /><TextBlock Text="Settings" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Content ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="TitleDrag" Grid.Row="0" Background="Transparent">
                    <TextBlock Text="GAMEINDEX" FontSize="12" CharacterSpacing="300" FontWeight="SemiBold" VerticalAlignment="Center" Margin="28,0,0,0" Foreground="{StaticResource OnArtSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" TextTrimming="CharacterEllipsis" Foreground="{StaticResource OnArtSecondaryBrush}" />
                    <TextBlock x:Name="ClockText" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,170,0" Foreground="{StaticResource OnArtTextBrush}" />
                </Grid>

                <!-- Toolbar -->
                <Grid x:Name="Toolbar" Grid.Row="1" Margin="28,4,28,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource OnArtTextBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="QuickButton" Click="QuickButton_Click" ToolTipService.ToolTip="Quick switch (Ctrl+K)" VerticalAlignment="Stretch" Padding="12,0">
                            <FontIcon Glyph="&#xE8AB;" FontSize="16" />
                        </Button>
                        <TextBox x:Name="SearchBox" Width="210" PlaceholderText="Search games" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox x:Name="PlatformCombo" Width="150" ItemsSource="{x:Bind ViewModel.PlatformOptions}" SelectionChanged="PlatformCombo_SelectionChanged" />
                        <ComboBox x:Name="CategoryCombo" Width="150" ItemsSource="{x:Bind ViewModel.CategoryOptions}" SelectionChanged="CategoryCombo_SelectionChanged" />
                        <ComboBox x:Name="SortCombo" Width="170" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" Visibility="{x:Bind ViewModel.SortVisibility, Mode=OneWay}">
                            <ComboBoxItem Content="Recently played" />
                            <ComboBoxItem Content="Alphabetical" />
                            <ComboBoxItem Content="Most played" />
                            <ComboBoxItem Content="Least played" />
                            <ComboBoxItem Content="Recently added" />
                            <ComboBoxItem Content="Largest games" />
                            <ComboBoxItem Content="Achievement completion" />
                        </ComboBox>
                        <SelectorBar x:Name="ViewBar" SelectionChanged="ViewBar_SelectionChanged">
                            <SelectorBarItem Text="Carousel" IsSelected="True"><SelectorBarItem.Icon><FontIcon Glyph="&#xE8A9;" /></SelectorBarItem.Icon></SelectorBarItem>
                            <SelectorBarItem Text="Grid"><SelectorBarItem.Icon><FontIcon Glyph="&#xE80A;" /></SelectorBarItem.Icon></SelectorBarItem>
                            <SelectorBarItem Text="List"><SelectorBarItem.Icon><FontIcon Glyph="&#xE8FD;" /></SelectorBarItem.Icon></SelectorBarItem>
                        </SelectorBar>
                    </StackPanel>
                </Grid>

                <!-- Views -->
                <Grid x:Name="Views" Grid.Row="2">

                    <!-- Carousel (PlayStation-style home) -->
                    <Grid x:Name="CarouselView" Visibility="{x:Bind ViewModel.CarouselVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="CarouselScroller" Grid.Row="0" Height="246" IsTabStop="True" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" PointerWheelChanged="Carousel_PointerWheelChanged">
                            <ItemsRepeater x:Name="CarouselRepeater" ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}" Margin="28,0">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="0" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameViewModel">
                                        <views:GameCard Game="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <StackPanel x:Name="InfoPanel" Grid.Row="2" Margin="40,0,40,30" Spacing="14" VerticalAlignment="Bottom" Visibility="{x:Bind ViewModel.InfoVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Background="{StaticResource ElevatedPanelBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="10,3">
                                    <TextBlock Text="{x:Bind ViewModel.Selected.PlatformBadge, Mode=OneWay}" FontSize="11" CharacterSpacing="120" FontWeight="SemiBold" Foreground="{StaticResource OnArtTextBrush}" />
                                </Border>
                                <Border Background="{StaticResource ElevatedPanelBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="10,3">
                                    <TextBlock Text="{x:Bind ViewModel.Selected.StatusText, Mode=OneWay}" FontSize="11" CharacterSpacing="120" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Selected.Title, Mode=OneWay}" FontFamily="Segoe UI Variable Display" FontSize="46" FontWeight="SemiBold" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Foreground="{StaticResource OnArtTextBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="PlayButton" Style="{StaticResource PlayButtonStyle}" Click="Play_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE768;" FontSize="16" /><TextBlock Text="PLAY" CharacterSpacing="150" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButtonStyle}" Click="Details_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE946;" FontSize="14" /><TextBlock Text="Game Details" /></StackPanel></Button>
                                <Button Style="{StaticResource GhostButtonStyle}" Click="Achievements_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE734;" FontSize="14" /><TextBlock Text="Achievements" /></StackPanel></Button>
                                <Button Style="{StaticResource GhostButtonStyle}" Click="Dlc_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7B8;" FontSize="14" /><TextBlock Text="Installed DLCs" /></StackPanel></Button>
                                <Button x:Name="MoreButton" Style="{StaticResource GhostButtonStyle}" ToolTipService.ToolTip="More actions">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Open Installation Folder" Click="OpenFolder_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Toggle Favorite" Click="Favorite_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB51;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Refresh Information" Click="Refresh_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Edit Game" Click="Edit_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Remove from Library" Click="Remove_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>
                                <views:StatTile Grid.Column="0" Label="TOTAL PLAYTIME" Value="{x:Bind ViewModel.Selected.PlaytimeText, Mode=OneWay}" Detail="{x:Bind ViewModel.Selected.PlaytimeDetail, Mode=OneWay}" />
                                <views:StatTile Grid.Column="1" Label="GAME SIZE" Value="{x:Bind ViewModel.Selected.SizeText, Mode=OneWay}" Detail="{x:Bind ViewModel.Selected.SizeDetail, Mode=OneWay}" />
                                <views:StatTile Grid.Column="2" Label="INSTALLED DLC" Value="{x:Bind ViewModel.Selected.DlcText, Mode=OneWay}" Detail="{x:Bind ViewModel.Selected.DlcDetail, Mode=OneWay}" />
                                <views:StatTile Grid.Column="3" Label="ACHIEVEMENTS" Value="{x:Bind ViewModel.Selected.AchievementsText, Mode=OneWay}" Detail="{x:Bind ViewModel.Selected.AchievementsDetail, Mode=OneWay}" />
                                <views:StatTile Grid.Column="4" Label="LAST PLAYED" Value="{x:Bind ViewModel.Selected.LastPlayedText, Mode=OneWay}" Detail="{x:Bind ViewModel.Selected.LastPlayedDetail, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Grid view -->
                    <GridView x:Name="LibraryGrid" Visibility="{x:Bind ViewModel.GridVisibility, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                              SelectionMode="Single" Padding="28,0,28,16" SelectionChanged="LibraryList_SelectionChanged" DoubleTapped="Library_DoubleTapped">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameViewModel">
                                <views:GameCard Game="{x:Bind}" AnimateDown="False" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- List view -->
                    <ListView x:Name="LibraryList" Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                              SelectionMode="Single" Padding="28,0,28,16" SelectionChanged="LibraryList_SelectionChanged" DoubleTapped="Library_DoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameViewModel">
                                <Grid Height="52" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="190" /><ColumnDefinition Width="90" /><ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" FontSize="15" TextTrimming="CharacterEllipsis" Foreground="{StaticResource OnArtTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind PlatformName}" VerticalAlignment="Center" Foreground="{StaticResource OnArtSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind PlaytimeText, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource OnArtSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource OnArtSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind LastPlayedText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource OnArtSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state (real state, never sample data) -->
                    <StackPanel Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="460">
                        <FontIcon Glyph="&#xE7FC;" FontSize="52" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" Foreground="{StaticResource OnArtTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Button Style="{StaticResource PlayButtonStyle}" Click="AddButton_Click" FontSize="14"><TextBlock Text="Add a game" /></Button>
                            <Button Style="{StaticResource GhostButtonStyle}" Click="ScanButton_Click"><TextBlock Text="Scan now" /></Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Overlays -->
                    <views:DetailsPanel x:Name="DetailsHost" Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}" />
                    <views:SettingsView x:Name="SettingsHost" Visibility="Collapsed" />

                    <!-- Quick switcher: type to jump to any game (Ctrl+K) -->
                    <Grid x:Name="QuickHost" Visibility="Collapsed" Background="#99000000" Tapped="QuickHost_Tapped">
                        <Border Style="{StaticResource GlassCardStyle}" Background="{StaticResource OverlayPanelBrush}" Width="580" MaxHeight="540"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36,0,0" Padding="16" Tapped="QuickPanel_Tapped">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="QuickBox" PlaceholderText="Type to find a game…" TextChanged="QuickBox_TextChanged" PreviewKeyDown="QuickBox_PreviewKeyDown" />
                                <ListView x:Name="QuickList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="QuickList_ItemClick" MaxHeight="400">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GameViewModel">
                                            <Grid Height="40" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind PlatformName}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Grid.Row="2" Text="Enter: select • Ctrl+Enter: play • Esc: close" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
