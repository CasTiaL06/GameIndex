<UserControl x:Class="GameIndex.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameIndex.ViewModels">
    <Border Style="{StaticResource GlassCardStyle}" Margin="28,0,28,24" Background="{StaticResource OverlayPanelBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="28,20,28,0">
                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}" Click="Close_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE711;" FontSize="12" /><TextBlock Text="Close" /></StackPanel></Button>
            </Grid>
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="10" Padding="28,10,28,28" MaxWidth="980" HorizontalAlignment="Left">

                    <TextBlock Text="LANGUAGE" FontSize="12" CharacterSpacing="150" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" />
                    <ComboBox Header="Language" SelectedIndex="{x:Bind Vm.LanguageIndex, Mode=TwoWay}" Width="260">
                        <ComboBoxItem Content="English" /><ComboBoxItem Content="Türkçe" /><ComboBoxItem Content="Follow Windows" />
                    </ComboBox>

                    <TextBlock Text="APPEARANCE" FontSize="12" CharacterSpacing="150" Foreground="{StaticResource AccentBrush}" Margin="0,18,0,0" />
                    <ComboBox Header="Theme" SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}" Width="260">
                        <ComboBoxItem Content="Dark" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Follow Windows" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Header="Accent color (hex)" Text="{x:Bind Vm.AccentHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="170" />
                        <Button Content="Pick color…" VerticalAlignment="Bottom">
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="AccentPicker" IsAlphaEnabled="False" ColorChanged="AccentPicker_ColorChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <ToggleSwitch Header="Enable transparency effects (turn off for solid, fully opaque windows)" IsOn="{x:Bind Vm.TransparencyEnabled, Mode=TwoWay}" />
                    <Slider Header="Settings / Details window opacity" Minimum="40" Maximum="100" Value="{x:Bind Vm.OverlayOpacity, Mode=TwoWay}" Width="420" HorizontalAlignment="Left" />
                    <Slider Header="Panel transparency (higher = more opaque)" Minimum="10" Maximum="100" Value="{x:Bind Vm.Transparency, Mode=TwoWay}" Width="420" HorizontalAlignment="Left" />
                    <ComboBox Header="Window material (system blur)" SelectedIndex="{x:Bind Vm.BackdropIndex, Mode=TwoWay}" Width="260">
                        <ComboBoxItem Content="Mica" /><ComboBoxItem Content="Mica Alt" /><ComboBoxItem Content="Acrylic (real blur-behind)" /><ComboBoxItem Content="None (solid)" />
                    </ComboBox>
                    <Slider Header="Background artwork dimming" Minimum="0" Maximum="80" Value="{x:Bind Vm.BackgroundDim, Mode=TwoWay}" Width="420" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Header="Custom fallback background image" Text="{x:Bind Vm.CustomBackground, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="420" PlaceholderText="Shown when no game artwork exists" />
                        <Button Content="Browse…" VerticalAlignment="Bottom" Click="BrowseBackground_Click" />
                    </StackPanel>
                    <ToggleSwitch Header="Animations" IsOn="{x:Bind Vm.AnimationsEnabled, Mode=TwoWay}" />
                    <Slider Header="Animation speed (%)" Minimum="50" Maximum="200" Value="{x:Bind Vm.AnimationSpeed, Mode=TwoWay}" Width="420" HorizontalAlignment="Left" />
                    <ToggleSwitch Header="Compact sidebar (icons only until expanded)" IsOn="{x:Bind Vm.SidebarCompact, Mode=TwoWay}" />
                    <TextBlock Text="Note: Windows exposes no adjustable blur radius for Mica/Acrylic, so blur strength is chosen via Window material plus the transparency slider." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />

                    <TextBlock Text="APPLICATION" FontSize="12" CharacterSpacing="150" Foreground="{StaticResource AccentBrush}" Margin="0,18,0,0" />
                    <ToggleSwitch Header="Start with Windows (current user, no admin rights)" IsOn="{x:Bind Vm.StartWithWindows, Mode=TwoWay}" />
                    <ToggleSwitch Header="Minimize to system tray (closing keeps playtime tracking running)" IsOn="{x:Bind Vm.MinimizeToTray, Mode=TwoWay}" />
                    <ToggleSwitch Header="Automatic game detection" IsOn="{x:Bind Vm.AutoDetect, Mode=TwoWay}" />
                    <NumberBox Header="Scan interval (minutes)" Minimum="1" Maximum="1440" SpinButtonPlacementMode="Inline" Value="{x:Bind Vm.ScanInterval, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" />
                    <ComboBox Header="Default library view" SelectedIndex="{x:Bind Vm.DefaultViewIndex, Mode=TwoWay}" Width="260">
                        <ComboBoxItem Content="Carousel" /><ComboBoxItem Content="Grid" /><ComboBoxItem Content="List" />
                    </ComboBox>
                    <ToggleSwitch Header="Automatic metadata refresh (DLC, achievements, platform playtime)" IsOn="{x:Bind Vm.AutoMetadata, Mode=TwoWay}" />

                    <TextBlock Text="SCAN DIRECTORIES (standalone games)" FontSize="12" CharacterSpacing="150" Foreground="{StaticResource AccentBrush}" Margin="0,18,0,0" />
                    <TextBlock Text="GameIndex never scans whole drives. Add folders that contain one sub folder per game, e.g. D:\Games." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ListView ItemsSource="{x:Bind Vm.ScanDirectories}" SelectionMode="None" MaxHeight="160">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Button Grid.Column="1" Content="Remove" Tag="{x:Bind}" Click="RemoveScanDir_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Add folder…" Click="AddScanDir_Click" />

                    <TextBlock Text="STEAM (achievements &amp; playtime)" FontSize="12" CharacterSpacing="150" Foreground="{StaticResource AccentBrush}" Margin="0,18,0,0" />
                    <TextBlock Text="Create a key at steamcommunity.com/dev/apikey. Your Steam profile's Game details must be Public. The key is stored encrypted with Windows DPAPI (tied to this Windows user) and is never written to the repository or logs. Passwords are never requested or stored." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Header="SteamID64 (optional, auto-detected from the local Steam install)" Text="{x:Bind Vm.SteamId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="420" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PasswordBox x:Name="SteamKeyBox" Header="Steam Web API key" Width="420" />
                        <Button Content="Save key" VerticalAlignment="Bottom" Click="SaveKey_Click" />
                        <Button Content="Remove key" VerticalAlignment="Bottom" Click="RemoveKey_Click" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Vm.SteamKeyState, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />

                    <TextBlock Text="PLATFORM INTEGRATIONS" FontSize="12" CharacterSpacing="150" Foreground="{StaticResource AccentBrush}" Margin="0,18,0,0" />
                    <ItemsControl ItemsSource="{x:Bind Vm.Integrations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:IntegrationRow">
                                <Border Style="{StaticResource GlassCardStyle}" Padding="14,10" Margin="0,0,0,8" Background="{StaticResource ElevatedPanelBrush}">
                                    <StackPanel Spacing="3">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"><Run Text="{x:Bind Name}" /><Run Text="  •  " /><Run Text="{x:Bind State}" /></TextBlock>
                                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="Enabled" OffContent="Disabled" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Capabilities}" FontSize="12" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Limitations}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="DATA" FontSize="12" CharacterSpacing="150" Foreground="{StaticResource AccentBrush}" Margin="0,18,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Backup database" Click="Backup_Click" />
                        <Button Content="Restore database…" Click="Restore_Click" />
                        <Button Content="Export library…" Click="Export_Click" />
                        <Button Content="Import library…" Click="Import_Click" />
                        <Button Content="Clear cache" Click="ClearCache_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Header="Backup location (empty = Data\Backups)" Text="{x:Bind Vm.BackupDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="420" />
                        <Button Content="Browse…" VerticalAlignment="Bottom" Click="BrowseBackup_Click" />
                    </StackPanel>

                    <TextBlock Text="PORTABLE MODE" FontSize="12" CharacterSpacing="150" Foreground="{StaticResource AccentBrush}" Margin="0,18,0,0" />
                    <TextBlock Text="{x:Bind Vm.ModeText}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap"><Run Text="Data directory: " /><Run Text="{x:Bind Vm.DataLocation}" /></TextBlock>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap"><Run Text="Database: " /><Run Text="{x:Bind Vm.DatabasePath}" /></TextBlock>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap"><Run Text="Artwork: " /><Run Text="{x:Bind Vm.ArtworkPath}" /></TextBlock>
                    <Button Content="Open data folder" Click="OpenData_Click" />

                    <TextBlock Text="{x:Bind Vm.Message, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
